# Dominio del servidor
DOMAIN=planificadormenus.es

# Email que pide Let's Encrypt para crear el certificado
LETSENCRYPT_EMAIL=mi-email@ejemplo.com

# Si se cambia la versión de la aplicación, actualizar el número
FRONTEND_IMAGE=ghcr.io/tu-usuario/planificador-menus-frontend:v1.0.0
BACKEND_IMAGE=ghcr.io/tu-usuario/planificador-menus-backend:v1.0.0

# Constantes para crear la base de datos y pasar a django
MYSQL_DATABASE=planificadormenus
MYSQL_USER=planificador
MYSQL_PASSWORD=contraseña
MYSQL_ROOT_PASSWORD=contraseña-del-usuario-root

# Constantes para django
SECRET_KEY=clave_muy_larga
DEBUG=False
ALLOWED_HOSTS=planificadormenus.es,www.planificadormenus.es
CORS_ALLOWED_ORIGINS=https://planificadormenus.es,https://www.planificadormenus.es
CSRF_TRUSTED_ORIGINS=https://planificadormenus.es,https://www.planificadormenus.es
GOOGLE_CLIENT_ID=id-google-oauth
AUTHORIZED_EMAIL=email@email.com,email2@email.com