# Exclusivamente para las pruebas locales con docker-compose.local.yml.
# Se crea una base MySQL independiente y solo se publica localhost:4200.
MYSQL_DATABASE=planificadormenus_local
MYSQL_USER=planificador_local
MYSQL_PASSWORD=local-database-password
MYSQL_ROOT_PASSWORD=local-root-password
SECRET_KEY=local-only-django-key-do-not-use-in-production-123456789

# ID público del mismo cliente OAuth configurado en
# pmangular/src/environments/environment.development.ts.
# Autoriza http://localhost y http://localhost:4200 como orígenes JavaScript.
# Si accedes por IP, autoriza también http://127.0.0.1:4200 en Google Cloud.
GOOGLE_CLIENT_ID=382559680999-s1o2t39gl0jhp2kttjt54djiscq0tlha.apps.googleusercontent.com
AUTHORIZED_EMAIL=tu-email@ejemplo.com
